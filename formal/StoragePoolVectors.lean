import KadmiumFormal.StoragePool

/-!
# Differential vectors for `KadmiumFormal.StoragePool`

Evaluates the Lean model (`validateShardCounts`, `validateStoredShardCounts`, `shardSize`,
`checkStoreQuota`, `runSwap`, `gf256Mul`, `gf256Inv`, `systematicCauchyRow`) and writes
`crates/kadmium-data/tests/fixtures/storage_pool_vectors.txt`, which
`crates/kadmium-data/tests/storage_pool_lean_vectors.rs` verifies against the Rust implementation.
-/

open Kadmium.StoragePool

def optNatStr : Option Nat → String
  | none => "none"
  | some v => toString v

def render : String := Id.run do
  let mut out := "# Generated by `lake exe storage_pool_vectors` from formal/StoragePoolVectors.lean. Do not edit.\n"
  for k in [0, 1, 2, 4, 8, 16, 17] do
    for m in [0, 1, 2, 3, 4, 8, 9] do
      let v1 := match validateShardCounts k m with | .ok t => s!"ok:{t}" | .error _ => "err"
      let v2 := match validateStoredShardCounts k m with | .ok t => s!"ok:{t}" | .error _ => "err"
      out := out ++ s!"shard_counts {k} {m} {v1} {v2}\n"
  for len in [0, 1, 7, 8, 9, 63, 64, 65, 4096, 65535] do
    for k in [1, 2, 4, 8, 16] do
      let sz := shardSize len k
      out := out ++ s!"shard_size {len} {k} {sz}\n"
  let quotaCases : List (Nat × Nat × Nat × Nat × Nat) := [
    (0, 128, 0, 1024, 134217728),
    (127, 128, 1000, 2000, 3000),
    (128, 128, 1000, 1, 3000),
    (10, 128, 2000, 1001, 3000)
  ]
  for (oo, mo, ob, nb, mt) in quotaCases do
    let q := if checkStoreQuota oo mo ob nb mt then 1 else 0
    out := out ++ s!"quota {oo} {mo} {ob} {nb} {mt} {q}\n"
  let swapTraces : List (String × List SwapEvent) := [
    ("stage_rotate_commit", [.stage 2, .rotate, .commit]),
    ("stage_rotate_crash_recover", [.stage 2, .rotate, .crash, .recoverAndCleanup]),
    ("stage_rotate_rollback", [.stage 2, .rotate, .rollback]),
    ("stage_crash_recover", [.stage 2, .crash, .recoverAndCleanup]),
    ("overwrite_twice_with_crash", [.stage 2, .rotate, .commit, .stage 3, .rotate, .crash, .recoverAndCleanup])
  ]
  for (label, trace) in swapTraces do
    let st := runSwap ⟨some 1, none, none⟩ trace
    out := out ++ s!"swap {label} {optNatStr st.final} {optNatStr st.old} {optNatStr st.staging}\n"
  for k in [1, 4, 8] do
    for sIdx in List.range (k + 2) do
      let row := systematicCauchyRow sIdx k
      let rowStr := String.intercalate "," (row.map (fun b => toString b.toNat))
      out := out ++ s!"cauchy_row {k} {sIdx} {rowStr}\n"
  let mediumCases : List (Nat × Nat × Nat × Nat) := [
    (0, 1280, 20, 2),
    (0, 20480, 85, 40),
    (5, 240, 12, 1),
    (10, 1280, 20, 2),
    (20, 20480, 85, 40),
    (240, 240, 12, 1),
    (640, 1280, 20, 2),
    (20480, 10240, 85, 40)
  ]
  for (offer, hw, pct, floor) in mediumCases do
    let avail := mediumAvailable offer hw
    let pledged := mediumPledged avail pct floor
    out := out ++ s!"medium_pledge {offer} {hw} {pct} {floor} {avail} {pledged}\n"
  return out

def main (args : List String) : IO UInt32 := do
  match args with
  | [] => IO.print render
  | [path] => IO.FS.writeBinFile path render.toUTF8
  | _ =>
    IO.eprintln "usage: storage_pool_vectors [output path]"
    return 2
  return 0
