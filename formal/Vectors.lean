import KadmiumFormal.RepOps.TreeSum

/-!
# Differential vectors for the RepOps reduction

Evaluates the Lean model's `treeSum` and writes the expected results that
`crates/kadmium-runtime/tests/repops_lean_vectors.rs` checks against `tree_sum`, `TreeReducer`
and the legacy `repops_pairwise_tree_sum`. The theorems are proved about the model; this fixture
is what ties the model to the Rust code.

Usage: `lake exe repops_vectors <output path>`; with no argument it prints to stdout. The file is
written as bytes so it has LF line endings on every OS.
-/

open Kadmium.RepOps

/-- SplitMix64 of `i + 1`. -/
def splitmix (i : Nat) : UInt64 :=
  let z : UInt64 := (i.toUInt64 + 1) * 0x9E3779B97F4A7C15
  let z := (z ^^^ (z >>> 30)) * 0xBF58476D1CE4E5B9
  let z := (z ^^^ (z >>> 27)) * 0x94D049BB133111EB
  z ^^^ (z >>> 31)

/-- Neither associative nor commutative: two reductions agree on it only when they combine the
same operands in the same tree. -/
def mix (a b : UInt64) : UInt64 :=
  let z := (a ^^^ (b * 0x9E3779B97F4A7C15)) * 0xBF58476D1CE4E5B9 + b
  z ^^^ (z >>> 29)

def leafMix (i : Nat) : UInt64 := splitmix i

/-- Finite, normal `f64` values with random sign and magnitudes from `2^-30` to `2^34`, so the
rounding of every addition depends on the order. -/
def leafF64 (i : Nat) : Float :=
  let h : UInt64 := splitmix (i + 0x1000)
  let sign : UInt64 := h &&& 0x8000000000000000
  let exponent : UInt64 := (993 : UInt64) + ((h >>> (52 : UInt64)) &&& (0x3F : UInt64))
  let mantissa : UInt64 := h &&& 0x000FFFFFFFFFFFFF
  Float.ofBits (sign ||| (exponent <<< (52 : UInt64)) ||| mantissa)

def hex16 (x : UInt64) : String :=
  let s := String.ofList (Nat.toDigits 16 x.toNat)
  "".pushn '0' (16 - s.length) ++ s

def sizes : List Nat :=
  List.range 131 ++ [255, 256, 257, 511, 512, 513, 1000, 1023, 1024, 1025, 4097]

def render : String := Id.run do
  let mut out := "# Generated by `lake exe repops_vectors` from formal/Vectors.lean. Do not edit.\n"
  out := out ++ "# Columns: n, treeSum mix (hex u64), treeSum f64 (hex bits).\n"
  out := out ++ "# Leaves and combines are defined identically in tests/repops_lean_vectors.rs.\n"
  for n in sizes do
    let m := treeSum mix 0 leafMix n
    let x := treeSum (· + ·) 0.0 leafF64 n
    out := out ++ s!"{n} {hex16 m} {hex16 x.toBits}\n"
  return out

def main (args : List String) : IO UInt32 := do
  match args with
  | [] => IO.print render
  | [path] => IO.FS.writeBinFile path render.toUTF8
  | _ =>
    IO.eprintln "usage: repops_vectors [output path]"
    return 2
  return 0
