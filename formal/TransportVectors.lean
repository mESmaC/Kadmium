import KadmiumFormal.Transport.ChunkMap

/-!
# Differential vectors for transport chunk maps

Evaluates the Lean model's `chunkPlan` and writes the expected chunk maps that
`crates/kadmium-data/tests/transport_lean_vectors.rs` checks against `chunk_plan` and against the
chunks `hash_stream` reads from a stream of that length. The theorems in
`KadmiumFormal/Transport/ChunkMap.lean` are proved about the model; this fixture ties the model to
the Rust code.

Usage: `lake exe transport_vectors <output path>`; with no argument it prints to stdout. The file
is written as bytes so it has LF line endings on every OS.
-/

open Kadmium.Transport

/-- Chunk sizes, including the real 16 MiB chunk for the sizes around its boundaries. -/
def cases : List (Nat × Nat) :=
  let small := [1, 2, 3, 7, 8, 4096]
  let sizes (c : Nat) := [0, 1, c - 1, c, c + 1, 2 * c - 1, 2 * c, 2 * c + 1, 5 * c + 3]
  (small.flatMap fun c => (sizes c).map fun b => (b, c))
    ++ (List.range 40).map (fun b => (b, 7))
    ++ [(0, 16777216), (1, 16777216), (16777215, 16777216), (16777216, 16777216),
        (16777217, 16777216)]

def render : String := Id.run do
  let mut out := "# Generated by `lake exe transport_vectors` from formal/TransportVectors.lean. Do not edit.\n"
  out := out ++ "# Columns: file bytes, chunk bytes, then offset:bytes for every chunk of chunkPlan.\n"
  for (b, c) in cases do
    let chunks := (chunkPlan b c).map fun (o, l) => s!"{o}:{l}"
    out := out ++ String.intercalate " " ([toString b, toString c] ++ chunks) ++ "\n"
  return out

def main (args : List String) : IO UInt32 := do
  match args with
  | [] => IO.print render
  | [path] => IO.FS.writeBinFile path render.toUTF8
  | _ =>
    IO.eprintln "usage: transport_vectors [output path]"
    return 2
  return 0
